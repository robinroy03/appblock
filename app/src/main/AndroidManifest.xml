<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Heads-up notifications at 50%/90% of an app's usage allowance -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets us show the system "ignore battery optimizations?" dialog, so
         aggressive OEM battery savers (OxygenOS etc.) don't kill the blocker -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Screen-time stats in the app picker; granted via the "Usage access"
         settings page, never a runtime prompt -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets us list all launchable apps on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="AppBlock"
        android:icon="@android:drawable/ic_lock_lock"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="Choose apps to block" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="Tie yourself to the mast" />

        <!-- Accessibility service: Android calls us the moment any app comes to the
             foreground. It also draws the block-wall overlay itself. -->
        <service
            android:name=".BlockerService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/blocker_service" />
        </service>
    </application>
</manifest>
