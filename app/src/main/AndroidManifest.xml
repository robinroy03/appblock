<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Heads-up notifications at 50%/90% of an app's usage allowance -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 16 QPR1+: lets the session countdown be a "Live Update"
         (status-bar chip + lock-screen capsule; OxygenOS calls them Live
         Alerts). Granted on install; the user can turn it off under
         Settings > Notifications > Live updates. Ignored on older versions. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Lets us show the system "ignore battery optimizations?" dialog, so
         aggressive OEM battery savers (OxygenOS etc.) don't kill the blocker -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- How the blocker sees which app is in front (usage events), plus
         screen-time stats in the app picker; granted via the "Usage access"
         settings page, never a runtime prompt -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- The block wall is an overlay window drawn over the blocked app;
         granted via the "Display over other apps" settings page -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The blocker is a foreground service (Android's only way to keep a
         poller alive); "special use" is the type for things like this -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Restart the blocker after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets us list all launchable apps on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="AppBlock"
        android:icon="@android:drawable/ic_lock_lock"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="Choose apps to block" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="Tie yourself to the mast" />

        <!-- The blocker: polls usage events for the foreground app and draws
             the block-wall overlay itself. -->
        <service
            android:name=".BlockerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches which app is in the foreground to enforce the user's own screen-time limits" />
        </service>

        <!-- Boot / in-place update: bring the blocker back. Both actions are
             protected system broadcasts, so exported is safe here. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
